# Local development. Docker Compose replaces DATABASE_URL with its db service URL.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://bob:bob@localhost:5432/bob
# Vercel + Neon pooled URL: null (do not keep idle DB connections in functions).
DATABASE_POOL_MODE=pooled
POSTGRES_USER=bob
POSTGRES_PASSWORD=bob
POSTGRES_DB=bob
POSTGRES_PORT=5432
API_PORT=8000
CORS_ORIGINS=[]

# All server AI calls use Claude. Never put provider keys in the mobile app.
AI_PROVIDER=claude
CLAUDE_API_KEY=
CLAUDE_MODEL_ID=claude-sonnet-5-5
CLAUDE_VISION_ENABLED=true
CLAUDE_CART_MODE=direct
CLAUDE_THINKING_MODE=between_tools
CLAUDE_EFFORT=low
DIRECT_CART_OUTPUT_MODE=schema

# Optional legacy provider for explicit comparisons; no automatic provider failover.
LABLUP_API_KEY=
LABLUP_BASE_URL=https://api.console.lablup.ai/anthropic
LABLUP_MODEL_ID=DeepSeek-V4.1-Flash-B300
# Enable only after scripts.check_lablup verifies this deployment's image input.
LABLUP_VISION_ENABLED=false
LABLUP_CART_MODE=verified
# Full-cart semantic layout plus independent per-item checks. Verify with your model before enabling.
CART_LAYOUT_VISION_ENABLED=false
CART_LAYOUT_TIMEOUT_SECONDS=40
AI_TIMEOUT_SECONDS=30
MAX_IMAGE_BYTES=10485760
TESSERACT_CMD=tesseract
# Vercel: OCR_BACKEND=python uses a bundled native wheel and language files.
OCR_BACKEND=cli
TESSDATA_DIR=vendor/tessdata

# Optional until actual Android push is connected.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_DIR=./credentials
# Compose: set to /run/credentials/firebase.json after adding the JSON file.
# Native Python: use the local absolute JSON file path instead.
GOOGLE_APPLICATION_CREDENTIALS=
# Vercel secret environment variable: complete Firebase service account JSON.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Vercel secret environment variable: random token, at least 32 characters.
# CRON_SECRET=
NOTIFICATIONS_HOUR=20
NOTIFICATION_POLL_SECONDS=60
